SELECT d.department_name,AVG(e.salary) AS average_salary,COUNT(e.employee_id) AS number_of_employees FROM departments d LEFT JOIN employees e ON d.department_id=e.department_id GROUP BY d.department_id,d.department_name;
CREATE VIEW delhi_employees AS SELECT CONCAT(e.first_name,' ',e.last_name) AS employee_name,e.employee_id,e.phone_number,j.job_title,d.department_name,CONCAT(m.first_name,' ',m.last_name) AS manager_name FROM employees e JOIN departments d ON e.department_id=d.department_id JOIN locations l ON d.location_id=l.location_id JOIN jobs j ON e.job_id=j.job_id LEFT JOIN employees m ON e.manager_id=m.employee_id WHERE l.city='Delhi';
